rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 共通の関数 ----

    // そのカレンダーのメンバーか（Step 33-F）
    function isMember(calendarId) {
      return request.auth.uid == calendarId
        || request.auth.uid in get(/databases/$(database)/documents/calendars/$(calendarId)).data.memberUids;
    }

    // そのカレンダーのオーナーか（Step 34-E）
    function isCalendarOwner(calendarId) {
      return get(/databases/$(database)/documents/calendars/$(calendarId)).data.ownerUid == request.auth.uid;
    }

    // そのカレンダーでの自分の肩書き（'owner' / 'editor' / 'viewer'）。名簿に自分の行が無ければ読めず、判定は「いいえ」になる（Step 37）
    function myRole(calendarId) {
      return get(/databases/$(database)/documents/calendars/$(calendarId)/members/$(request.auth.uid)).data.role;
    }

    // そのカレンダーの予定・タスクを書き換えてよいか（Step 37）
    // 左：マイカレンダー（id ＝ uid。名簿が無いので肩書きを見ない）／ 右：共有カレンダーのオーナーか編集者
    function canEdit(calendarId) {
      return request.auth.uid == calendarId
        || myRole(calendarId) in ['owner', 'editor'];
    }

    // 自分のメールアドレス（小文字）。招待状の宛先と比べる（Step 36-G）
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // メールアドレスの持ち主確認が済んでいるか（Step 39）。確認メールのリンクを押した人だけ「はい」。
    // Google でログインした人は最初から「はい」。値は通行証（ID トークン）に書かれているので、
    // リンクを押したあとはアプリ側で通行証を作り直す（getIdToken(true)）まで古いまま
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // そのカレンダーから自分宛てに届いた招待状の住所（Step 36-A で決めた「カレンダーid_メール」）
    function myInvitePath(calendarId) {
      return /databases/$(database)/documents/invites/$(calendarId + '_' + myEmail());
    }

    // 自分宛ての招待状が「返事待ち」で、この書き込みで「承認済み」になるか（Step 36-G）
    // メールの持ち主確認が済んでいること（Step 39）。名簿の行の作成・部屋の memberUids の追加も、この関数を通るので一緒に塞がる
    function isAcceptingInvite(calendarId) {
      return isEmailVerified()
        && get(myInvitePath(calendarId)).data.status == 'pending'
        && getAfter(myInvitePath(calendarId)).data.status == 'accepted';
    }

    // 名簿の行に写す名前とメールが、本人のものか（Step 46）。
    // 名簿の行は本人が自分の分を書く（作成・承認）。他人の名前やメールを名乗らせないため、通行証（ID トークン）と照合する。
    // get(項目, 既定値) … 項目が無ければ既定値（null）を使う。書かなくてもよいが、書くなら本人のもの
    function isOwnNameAndEmail() {
      return request.resource.data.get('email', null) in [null, myEmail()]
        && request.resource.data.get('displayName', null) in [null, request.auth.token.get('name', null)];
    }

    // ---- users（Step 28 / 46） ----

    // 名刺は本人だけが読める（Step 46）。他人のメール・fcmTokens・mutedCalendarIds を読ませない。
    // 招待の相手探しはサーバーの関数 sendInvite、通知の宛先探しは notifyInvite / notifyScheduleChange が
    // 管理者の権限で読む（ルールに縛られない）。メンバー画面の名前は名簿の行に写してある
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ---- events（Step 33-F / 37） ----

    match /events/{eventId} {
      // 見るのはメンバー全員（閲覧者も）
      allow read: if request.auth != null
        && isMember(resource.data.calendarId);

      // 書き換えはオーナーと編集者だけ（閲覧者は読むだけ。Step 37）
      allow delete: if request.auth != null
        && canEdit(resource.data.calendarId);

      // updatedBy（最後に書いた人。Step 44）は必ず自分。通知の「誰が」を詐称させない
      allow create: if request.auth != null
        && canEdit(request.resource.data.calendarId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if request.auth != null
        && canEdit(resource.data.calendarId)
        && request.resource.data.calendarId == resource.data.calendarId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // ---- calendars（Step 31 / 32 / 34 / 36） ----

    match /calendars/{calendarId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.id == calendarId;

      // オーナーが memberUids を書き換える（メンバーを外す。Step 34）
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && request.auth.uid in request.resource.data.memberUids;

      // 招待された人が、承認と同時に memberUids へ自分だけを足す（Step 36-G）
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.auth.uid in request.resource.data.memberUids
        && isAcceptingInvite(calendarId);

      match /members/{memberUid} {
        allow read: if request.auth != null && isMember(calendarId);

        // カレンダーを作った人が、自分をオーナーとして書く（Step 32）。名前とメールは本人のもの（Step 46）
        allow create: if request.auth != null
          && memberUid == request.auth.uid
          && request.resource.data.role == 'owner'
          && isOwnNameAndEmail()
          && getAfter(/databases/$(database)/documents/calendars/$(calendarId)).data.ownerUid == request.auth.uid;

        // 招待された人が、承認と同時に自分の行を書く（Step 36-G）
        allow create: if request.auth != null
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == get(myInvitePath(calendarId)).data.role
          && request.resource.data.invitedBy == get(myInvitePath(calendarId)).data.invitedBy
          && isOwnNameAndEmail()
          && isAcceptingInvite(calendarId);

        allow update: if request.auth != null
          && isCalendarOwner(calendarId)
          && memberUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['editor', 'viewer'];

        allow delete: if request.auth != null
          && isCalendarOwner(calendarId)
          && memberUid != request.auth.uid;
      }
    }

    // ---- invites（Step 35-F / 36-G / 39 / 46） ----
    // 招待状を作る・送り直すのは、Step 46 からサーバーの関数 sendInvite だけ（管理者の権限なのでルールは不要）。
    // アプリからの create と、オーナーの送り直しの update は削除した

    match /invites/{inviteId} {
      // 宛先の本人だけが読める。ただしメールの持ち主確認が済んでいること（Step 39）
      allow read: if request.auth != null
        && isEmailVerified()
        && resource.data.invitedEmail == myEmail();

      // 宛先の本人が返事をする（返事待ち → 承認 / 拒否。status 以外は変えられない）。確認済みの人だけ（Step 39）
      allow update: if request.auth != null
        && isEmailVerified()
        && resource.data.invitedEmail == myEmail()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
    }
  }
}
